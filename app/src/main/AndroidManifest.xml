<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal required permissions: zero location, contacts, or overlay permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MultiBoxApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:largeHeap="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- Main Process: Dashboard, Account Vault & Macro Editor -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Isolated Box Worker Processes (:box_1 .. :box_8) -->
        <service android:name=".service.BoxRunnerService1" android:process=":box_1" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity1" android:process=":box_1" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".service.BoxRunnerService2" android:process=":box_2" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity2" android:process=":box_2" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".service.BoxRunnerService3" android:process=":box_3" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity3" android:process=":box_3" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".service.BoxRunnerService4" android:process=":box_4" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity4" android:process=":box_4" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".service.BoxRunnerService5" android:process=":box_5" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity5" android:process=":box_5" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".service.BoxRunnerService6" android:process=":box_6" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity6" android:process=":box_6" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".service.BoxRunnerService7" android:process=":box_7" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity7" android:process=":box_7" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".service.BoxRunnerService8" android:process=":box_8" android:exported="false" android:foregroundServiceType="dataSync" />
        <activity android:name=".ui.box.BoxActivity8" android:process=":box_8" android:exported="false" android:launchMode="singleInstance" android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>
